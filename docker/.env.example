# Copy this file to .env and fill in real values before running docker-compose.
# Never commit .env to version control.

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=barqflow

# JWT signing secret — minimum 32 random characters
JWT_SECRET=change_me_jwt_secret_minimum_32_chars

# AES-256-GCM encryption key — must be exactly 32 bytes
BARQFLOW_ENCRYPTION_KEY=change_me_exactly_32_bytes_key__

# Server port
PORT=3000

# Log level
RUST_LOG=info,barqflow=debug
